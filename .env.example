# =======================
# Autenticazione (OBBLIGATORIO in produzione)
# =======================

# Nome utente amministratore
AUTH_USERNAME=admin

# Password in chiaro (l'app la bcrypta in memoria all'avvio).
# In alternativa usa AUTH_PASSWORD_HASH con un hash bcrypt già calcolato.
AUTH_PASSWORD=cambia-questa-password

# Alternativa: hash bcrypt precalcolato (prefisso $2a$ o $2b$).
# Generalo con: node -e "console.log(require('bcryptjs').hashSync('mia-password',10))"
# AUTH_PASSWORD_HASH=$2a$10$...

# Chiave di firma dei cookie/JWT di sessione (min. 32 caratteri consigliato).
# Genera con: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=

# Forza il flag Secure sul cookie di sessione (metti "true" se servito solo via HTTPS)
COOKIE_SECURE=true

# =======================
# Generali
# =======================

# Porta interna del container
PORT=3000

# Cartella dati (in Docker/Coolify montare un volume persistente qui)
DATA_DIR=/data
