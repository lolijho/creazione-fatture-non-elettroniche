# =======================
# Autenticazione (OBBLIGATORIO in produzione)
# =======================

# Nome utente amministratore
AUTH_USERNAME=admin

# Password in chiaro (l'app la bcrypta in memoria all'avvio).
# In alternativa usa AUTH_PASSWORD_HASH con un hash bcrypt già calcolato.
AUTH_PASSWORD=cambia-questa-password

# Alternativa: hash bcrypt precalcolato (prefisso $2a$ o $2b$).
# Generalo con: node -e "console.log(require('bcryptjs').hashSync('mia-password',10))"
# AUTH_PASSWORD_HASH=$2a$10$...

# Chiave di firma dei cookie/JWT di sessione (min. 32 caratteri consigliato).
# Genera con: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=

# Forza il flag Secure sul cookie di sessione (metti "true" se servito solo via HTTPS)
COOKIE_SECURE=true

# =======================
# Generali
# =======================

# Porta interna del container
PORT=3000

# Cartella dati (in Docker/Coolify montare un volume persistente qui)
# Vi vengono salvati i PDF generati, gli upload temporanei e il file di
# migrazione one-shot dal vecchio storage JSON a Postgres.
DATA_DIR=/data

# =======================
# Database (OBBLIGATORIO)
# =======================

# URL connessione Postgres. Su Coolify aggiungi il servizio "PostgreSQL"
# e copia l'URL interna fornita (es. postgres://user:pass@db:5432/fatture).
DATABASE_URL=postgresql://user:password@host:5432/fatture

# Forza SSL anche se non presente nell'URL (es. provider managed che lo richiedono).
# DATABASE_SSL=true

# =======================
# Email SMTP (per "Invia fattura per email")
# =======================

# Host SMTP del provider (Resend, Brevo, SendGrid, Mailgun, SMTP2GO, Gmail, ecc.)
SMTP_HOST=
SMTP_PORT=587
# true se la connessione usa TLS implicito (porta 465). False per STARTTLS (587).
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
# Mittente "From". Es: "Mio Studio <fatture@example.com>"
SMTP_FROM=
# Opzionale: Reply-To diverso dal mittente
# SMTP_REPLY_TO=
